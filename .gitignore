.venv/
__pycache__/
*.pyc
data/
results/raw/**/*.npy
results/raw/**/*.npz
.ipynb_checkpoints/
*.pt
*.pth

# hardware-probe evidence frames, written by rover/hardware_tests on every run
rover_camera_sample_*.jpg

# Transport bundle pasted in on 2026-09-28. Its whole content is committed in
# literature/ (verified an identical tree) plus CAMPUS_SESSION_HANDOFF.md and
# literature/BUNDLE_README.md, so tracking it too would duplicate a 2.8 MB tree.
# Kept on disk; see docs/CAMPUS_HANDOFF_INTEGRATION.md.
PC-handoff/

# Rover-view tomato dataset: image bytes and cached archives live on the dataset
# volume (see dataset/config.yaml). Only scripts, metadata and documentation are
# tracked. A sample grid under documentation/ is small and IS tracked.
dataset/raw/
dataset/processed/

# Camera sessions: logs and analysis are tracked; captured frames are personal
# images and stay local unless deliberately added.
camera_sessions/*/frames/

# Paper 2 literature search: per-query raw records (12.7 MB) are local only;
# unique_records.csv holds every retrieved work after deduplication.
results/litsearch_paper2/raw_records.csv
results/litsearch_paper2/supplement/raw_records.csv

# rover-camera artefact photos show the room; kept on disk only, like session frames
results/rover_artifacts/*/*.jpg
